# Klucz OpenAI do generowania grafik (bez klucza aplikacja działa w trybie DEMO)
OPENAI_API_KEY=
# Model generowania obrazów i jakość (low / medium / high)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
# openai | demo (puste = openai, jeśli jest klucz)
IMAGE_PROVIDER=
# Ile obrazków generować równolegle
GENERATION_WORKERS=3
PORT=5000
